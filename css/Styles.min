@font-face{font-family:Fredoka;src:url(../fonts/Fredoka-VariableFont_wdth,wght.ttf)format("woff2-variations");font-weight:100 900;font-stretch:75% 125%;font-style:normal;font-display:swap}*,:before,:after{box-sizing:border-box}:root{--color-primario:#fbbf24;--color-primario-claro:#ffdd57;--color-primario-oscuro:#f59e0b;--color-bg-oscuro:#212121;--color-bg-blanco:#fefce8;--color-borde-oscuro:#3d3d3d;--color-texto:var(--color-borde-oscuro);--color-blanco-puro:#fff;--color-texto-secundario:#555;--color-texto-secundario-oscuro:#ccc;--color-bg-tarjeta-oscuro:#2b2b2b;--fuente-principal:"Fredoka", monospace;--peso-ligero:300;--peso-normal:400;--peso-titulo:700;--padding-seccion:4rem;--espaciado-xs:.5rem;--espaciado-sm:.75rem;--espaciado-md:1rem;--espaciado-lg:1.5rem;--espaciado-xl:2rem;--radio-pildora:50px;--radio-pequeno:.75rem;--radio-mediano:1rem;--radio-grande:1.25rem;--tam-titulo:clamp(1.75rem, 1rem + 3vw, 3rem)}body{background-color:var(--color-bg-blanco);font-family:var(--fuente-principal);grid-template-columns:minmax(0,1fr);grid-template-areas:"header""main""footer";margin:0;display:grid}h2{font-size:var(--tam-titulo)}main{grid-area:main;min-width:0}.encabezado{align-items:center;gap:var(--espaciado-xl);padding:var(--espaciado-sm) max(1.25rem, min(5vw, 4rem));background-color:var(--color-bg-oscuro);z-index:1000;grid-area:header;grid-template-columns:1fr auto 1fr;display:grid;position:sticky;top:0}.encabezado__marca{align-items:center;gap:var(--espaciado-xs);width:fit-content;color:var(--color-bg-blanco);text-decoration:none;display:inline-flex}.encabezado__icono{background-color:var(--color-primario);border-radius:50%;place-items:center;width:2.5rem;height:2.5rem;font-size:clamp(1.1rem,.7rem + 1.5vw,1.25rem);transition:rotate .16s;display:grid}.encabezado__marca:hover .encabezado__icono,.encabezado__marca:focus-visible .encabezado__icono{rotate:10deg}.encabezado__texto{line-height:1;display:grid}.encabezado__nombre{font-size:clamp(1rem,.8rem + .5vw,1.1rem)}.encabezado__eslogan{color:var(--color-primario);font-size:clamp(.5rem,.4rem + .2vw,.55rem);font-weight:var(--peso-titulo);letter-spacing:.16em;margin-top:.2rem}.navegacion__lista{align-items:center;gap:clamp(.5rem, 2vw, var(--espaciado-xl));flex-wrap:wrap;margin:0;padding:0;list-style:none;display:flex}.navegacion__link{color:var(--color-bg-blanco);font-size:clamp(.75rem,.5rem + .8vw,.9rem);text-decoration:none;transition:color .16s}.navegacion__link:hover,.navegacion__link:focus-visible{color:var(--color-primario)}.encabezado__pedido{justify-self:end;margin:0;padding:.65rem 1.25rem;font-size:clamp(.75rem,.65rem + .2vw,.8rem)}.encabezado__pedido:hover:before{content:"👤"}.boton{font-weight:var(--peso-titulo);text-decoration:none;transition:translate .16s,scale .16s,background-color .16s,color .16s,box-shadow .16s}.boton--primario:hover,.boton--primario:focus-visible,.boton--secundario:hover,.boton--secundario:focus-visible{translate:0 -2px;scale:1.03}.boton--primario{background-color:var(--color-primario);color:var(--color-texto);width:fit-content;padding:var(--espaciado-sm) var(--espaciado-xl);margin-top:var(--espaciado-xs);border-radius:var(--radio-pildora);justify-content:center;align-items:center;gap:var(--espaciado-xs);border:none;display:inline-flex}.boton--primario:hover,.boton--primario:focus-visible{background-color:var(--color-primario-oscuro);box-shadow:0 0 16px var(--color-primario-oscuro)}.boton--secundario{color:var(--color-primario);width:fit-content;padding:var(--espaciado-sm) var(--espaciado-xl);margin-top:var(--espaciado-xs);border:.1rem solid var(--color-primario);border-radius:var(--radio-pildora);justify-content:center;align-items:center;gap:var(--espaciado-xs);background-color:#0000;display:inline-flex}.boton--secundario:hover,.boton--secundario:focus-visible{background-color:var(--color-primario-claro);color:var(--color-bg-oscuro)}.acciones{gap:var(--espaciado-md);flex-wrap:wrap;display:flex}.acciones--centrado{justify-content:center}.etiqueta{background-color:var(--color-primario);color:var(--color-borde-oscuro);font-weight:var(--peso-titulo);border-radius:var(--radio-pildora);width:fit-content;max-width:var(--peso-titulo);border:none;justify-content:center;align-items:center;padding:.3rem .7rem;display:inline}.tarjetas{gap:var(--espaciado-lg);margin-top:var(--espaciado-lg);grid-template-columns:repeat(4,minmax(0,1fr));display:grid}.tarjeta{background-color:var(--color-bg-blanco);border-radius:var(--radio-grande);padding:var(--espaciado-lg);text-align:center;border:1px solid #0000001a;width:100%;min-width:0;margin:0;box-shadow:0 4px 15px #0000001a;& img{object-fit:cover;border-radius:var(--radio-pequeno);width:100%;height:200px;margin-bottom:var(--espaciado-xs)}& .etiqueta{margin:var(--espaciado-xs) 0;display:inline-block}}.tarjeta__titulo{font-size:clamp(1.2rem,.8rem + 1vw,1.4rem);font-weight:var(--peso-titulo);margin:var(--espaciado-xs) 0;color:var(--color-bg-oscuro)}.tarjeta__descripcion{margin:var(--espaciado-xs) 0;color:var(--color-texto-secundario);font-size:clamp(.9rem,.8rem + .3vw,.95rem)}.tarjeta__precio{font-size:clamp(1.3rem,.8rem + 1.5vw,1.5rem);font-weight:var(--peso-titulo);color:var(--color-primario-oscuro);margin:var(--espaciado-xs) 0}.tarjeta a,.tarjeta .boton{background-color:var(--color-primario);color:var(--color-borde-oscuro);font-weight:var(--peso-titulo);border-radius:var(--radio-pildora);margin-top:var(--espaciado-xs);justify-content:center;align-items:center;width:fit-content;padding:.65rem 1.75rem;text-decoration:none;display:inline-flex}#inicio{background-color:var(--color-bg-oscuro);min-height:100vh;padding:var(--padding-seccion);background-image:url(../assets/images/inicio/Imagen__Fondo-1280w.webp);background-position:50%;background-repeat:no-repeat;background-size:cover}.hero__titulo{color:var(--color-blanco-puro);font-size:clamp(3.5rem,2.5rem + 3vw,4.5rem);line-height:1.15;font-weight:var(--peso-titulo);max-width:40%}.hero__titulo--destacado{color:var(--color-primario);font-weight:inherit;font-size:inherit;max-width:inherit}.hero__subtitulo{color:var(--color-primario);margin-top:var(--espaciado-xs);margin-bottom:var(--espaciado-md);max-width:40%;font-size:clamp(1.1rem,.7rem + 1.5vw,1.5rem)}#promociones{background-color:var(--color-bg-blanco);padding:var(--padding-seccion);text-align:center}.promociones__titulo{color:var(--color-bg-oscuro)}#favoritos{background-color:var(--color-bg-oscuro);padding:var(--padding-seccion);text-align:center}.favoritos__titulo{color:var(--color-bg-blanco)}#favoritos .tarjeta{background-color:var(--color-bg-tarjeta-oscuro);border-color:var(--color-borde-oscuro);color:var(--color-bg-blanco)}#favoritos .tarjeta__titulo{color:var(--color-bg-blanco)}#favoritos .tarjeta__descripcion{color:var(--color-texto-secundario-oscuro)}#favoritos .tarjeta__precio{color:var(--color-primario)}#nosotros{padding:var(--padding-seccion);text-align:center}.nosotros{color:var(--color-borde-oscuro)}.nosotros h2{color:var(--color-bg-oscuro)}.nosotros__mosaico{justify-content:center;align-items:center;gap:var(--espaciado-lg);margin:0 auto var(--espaciado-xl);max-width:800px;display:flex}.nosotros__imagen{border-radius:var(--radio-mediano);object-fit:cover;box-shadow:0 4px 10px #00000026}.nosotros__imagen--principal{width:60%;height:auto}.nosotros__columna{gap:var(--espaciado-lg);flex-direction:column;width:35%;display:flex}.nosotros__imagen--secundaria{width:100%;height:auto}.nosotros__dato{background-color:var(--color-primario);padding:var(--espaciado-lg);border-radius:var(--radio-mediano);color:var(--color-borde-oscuro);text-align:center;flex-direction:column;justify-content:center;align-items:center;display:flex;& b{font-size:clamp(2rem,1rem + 2.5vw,2.5rem);line-height:1;font-weight:var(--peso-titulo)}& span{font-size:clamp(1rem,.7rem + .8vw,1.1rem);font-weight:var(--peso-normal)}}.nosotros__lista{justify-content:center;gap:var(--espaciado-xl);margin-top:var(--espaciado-xl);flex-wrap:wrap;padding:0;list-style:none;display:flex}.nosotros__item{font-weight:var(--peso-titulo);color:var(--color-borde-oscuro);font-size:clamp(1rem,.6rem + 1vw,1.2rem)}#horarios{background-color:var(--color-bg-oscuro);padding:var(--padding-seccion);text-align:center}.horarios__subtitulo{font-size:var(--tam-titulo);color:var(--color-primario);margin-top:.7rem;margin-bottom:var(--espaciado-md)}.horarios__subtitulo--destacado{color:var(--color-bg-blanco);font-weight:inherit;font-size:inherit;max-width:inherit}.horarios__lista{gap:var(--espaciado-sm);max-width:900px;margin:var(--espaciado-xl) auto 0;grid-template-columns:repeat(2,minmax(0,1fr));display:grid}.horarios__item{justify-content:space-between;align-items:center;gap:var(--espaciado-md);padding:var(--espaciado-md) 1.25rem;border-radius:var(--radio-mediano);background-color:var(--color-borde-oscuro);text-align:left;display:flex}.horarios__item b{color:var(--color-primario)}.horarios__item p{color:var(--color-bg-blanco);text-align:right;margin:0}#delivery{background-color:var(--color-bg-oscuro);padding:var(--padding-seccion);text-align:center}.delivery{color:var(--color-bg-blanco)}.delivery h2{color:var(--color-bg-blanco);margin-top:var(--espaciado-xs)}.delivery p{margin-bottom:var(--espaciado-xl);font-size:clamp(1rem,.7rem + .8vw,1.1rem)}.delivery small{background-color:var(--color-borde-oscuro);color:var(--color-primario);padding:var(--espaciado-xs) var(--espaciado-md);border-radius:var(--radio-pildora);margin:var(--espaciado-lg) var(--espaciado-xs) 0;font-weight:var(--peso-normal);font-size:clamp(.8rem,.6rem + .5vw,.9rem);display:inline-block}.delivery__acciones .boton--primario{padding:var(--espaciado-md) 2.5rem;font-size:clamp(1rem,.7rem + .8vw,1.1rem);box-shadow:0 4px 6px #0000004d}#contacto{background-color:var(--color-bg-oscuro);padding:var(--padding-seccion);text-align:center}.footer{color:var(--color-bg-blanco);text-align:left;padding-bottom:var(--espaciado-xl);grid-area:footer}#contacto.footer{text-align:left}.footer__seccion h3,.footer__seccion h4{color:var(--color-primario);margin-bottom:var(--espaciado-md);font-size:clamp(1.1rem,.7rem + 1vw,1.2rem)}.footer__seccion p{margin:var(--espaciado-xs) 0;font-weight:var(--peso-ligero);font-size:clamp(.9rem,.8rem + .3vw,.95rem);line-height:1.4}.footer__lista{gap:var(--espaciado-sm);flex-direction:column;margin:0;padding:0;list-style:none;display:flex}.footer__item a{color:var(--color-bg-blanco);font-weight:var(--peso-ligero);font-size:clamp(.9rem,.8rem + .3vw,.95rem);text-decoration:none;transition:color .2s}.footer__item a:hover,.footer__item a:focus-visible{color:var(--color-primario)}.footer hr{border:none;border-top:1px solid var(--color-borde-oscuro);margin:var(--espaciado-xl) 0 var(--espaciado-md)}@media (width>=601px) and (width<=1023px){:root{--padding-seccion:clamp(2rem, 5vw, 3rem)}.encabezado{gap:var(--espaciado-sm);grid-template-columns:1fr auto}.encabezado__nav{grid-area:2/1/auto/-1}.navegacion__lista{justify-content:center;gap:.6rem clamp(.5rem,2vw,1.25rem)}.encabezado__pedido{grid-area:1/2}.hero__titulo{max-width:65%;font-size:clamp(3.5rem,2.5rem + 3vw,4.5rem)}.hero__subtitulo{max-width:65%}.tarjetas,.horarios__lista{grid-template-columns:repeat(2,minmax(0,1fr))}.nosotros__mosaico{max-width:700px}.footer{gap:var(--espaciado-xl);grid-template-columns:repeat(2,minmax(0,1fr));display:grid}.footer__seccion{flex-direction:column;display:flex}.footer>hr,.footer>p:last-child{text-align:center;grid-column:1/-1}}@media (width<=600px){:root{--padding-seccion:1.5rem}#inicio,#promociones,#favoritos,#nosotros,#horarios,#delivery,#contacto{padding:var(--padding-seccion) 1.25rem}.encabezado{gap:var(--espaciado-xs);padding:var(--espaciado-xs) 1rem;grid-template-columns:minmax(0,1fr) auto}.encabezado__nav{grid-area:2/1/auto/-1}.navegacion__lista{justify-content:center;gap:var(--espaciado-xs) clamp(.25rem, 2vw, var(--espaciado-md))}.navegacion__link{font-size:clamp(.7rem,.45rem + .8vw,.85rem)}.encabezado__pedido{padding:var(--espaciado-xs) var(--espaciado-md);grid-area:1/2}#inicio{background-position:60%;flex-direction:column;justify-content:center;min-height:75svh;display:flex}.hero__titulo{max-width:none;font-size:clamp(2.8rem,1rem + 8vw,4rem)}.hero__subtitulo{max-width:none}.acciones{gap:var(--espaciado-xs)}.boton--primario,.boton--secundario{padding:var(--espaciado-sm) var(--espaciado-lg)}.tarjetas{grid-template-columns:minmax(0,1fr)}.tarjeta img{aspect-ratio:8/5;height:auto}.horarios__lista{grid-template-columns:minmax(0,1fr)}.nosotros__mosaico{gap:var(--espaciado-md);flex-direction:column}.nosotros__imagen--principal,.nosotros__columna{width:100%}.nosotros__imagen--principal{max-height:18rem}.nosotros__columna{max-width:24rem}.nosotros__lista{gap:var(--espaciado-md)}.delivery__acciones{align-items:stretch}.delivery__acciones .boton{width:100%}.delivery small{margin:var(--espaciado-xs) 0 0}.footer{gap:var(--espaciado-md);padding-bottom:var(--espaciado-lg);grid-template-columns:minmax(0,1fr);display:grid}.footer>hr,.footer>p:last-child{text-align:center;grid-column:1}}@media (width>=1024px){.footer{gap:var(--espaciado-xl);grid-template-columns:repeat(4,minmax(0,1fr));display:grid}.footer__seccion{flex-direction:column;display:flex}.footer>hr,.footer>p:last-child{text-align:center;grid-column:1/-1}}